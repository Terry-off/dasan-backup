;(() => {
	// 재실행 가드 — 구현은 전부 IIFE 클로저에 캡슐화하고, 외부에는 이 marker 하나만 남긴다
	// (위젯 HTML 재주입 등으로 스크립트가 다시 실행돼도 observer/리스너 중복 바인딩 방지)
	if (window.__bsShopViewPromotionTracking) return;
	window.__bsShopViewPromotionTracking = true;

	const VIEW_EVENT_NAME = 'view_component_promotion_shop_view';
	const VIEW_EVENT_META = { action: 'view', target: 'component', content: 'promotion', where: 'shop_view' };
	const CLICK_EVENT_NAME = 'click_promotion_shop_view';
	const CLICK_EVENT_META = { action: 'click', content: 'promotion', where: 'shop_view' };

	// cart 컨텍스트 도메인(cart_code 보유 — 레거시 카트 markup 이 site_shop.js 로 생성)이 같은
	// 문서에 유입돼도 shop_view 이벤트로 오발화하지 않도록 제외한다. PDP 도메인(레거시 포함)은
	// cart 식별자를 갖지 않는다.
	const parseDomain = (el) => {
		try {
			const domain = JSON.parse(el.dataset.bsPromotion);
			if (domain && domain.cart_code !== undefined) return null;
			return domain;
		} catch (_) {
			return null;
		}
	};

	// 노출 dedup — 같은 혜택이 여러 표면(혜택 섹션·혜택가 ⓘ 등)에 동시 노출될 수 있어
	// 표면(promotion_ui_area)까지 키에 포함. 스크립트는 위젯에서 1회만 로드되고 AJAX 재렌더는
	// 스크립트를 다시 싣지 않으므로 클로저 보존으로 충분하다.
	const trackedKeys = new Set();

	// SDK 미로드/파싱 실패 시 false — unobserve 를 보류해 viewport 재진입 시 재시도.
	const trackView = (el) => {
		const domain = parseDomain(el);
		if (!domain) return false;
		if (!window.BrandScope || typeof window.BrandScope.track !== 'function') return false;
		const dedupKey = (domain.prod_code || '') + '|' + (domain.promotion_code || '') + '|' + (domain.promotion_ui_area || '');
		if (trackedKeys.has(dedupKey)) return true;
		trackedKeys.add(dedupKey);
		window.BrandScope.track(VIEW_EVENT_NAME, { ...VIEW_EVENT_META, ...domain });
		return true;
	};

	const observed = new WeakSet();
	const io = new IntersectionObserver((entries, observer) => {
		entries.forEach((entry) => {
			if (!entry.isIntersecting) return;
			if (trackView(entry.target)) observer.unobserve(entry.target);
		});
