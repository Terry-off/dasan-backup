		if (!root.querySelectorAll) return;
		const targets = root.matches && root.matches('[data-bs-promotion]')
			? [root, ...root.querySelectorAll('[data-bs-promotion]')]
			: root.querySelectorAll('[data-bs-promotion]');
		targets.forEach((el) => {
			if (observed.has(el)) return;
			observed.add(el);
			io.observe(el);
		});
	};
	observeAll(document);
	new MutationObserver((mutations) => {
		mutations.forEach((mutation) => mutation.addedNodes.forEach((node) => {
			if (node.nodeType === 1) observeAll(node);
		}));
	}).observe(document.body, { childList: true, subtree: true });

	document.addEventListener('click', (event) => {
		const btn = event.target.closest ? event.target.closest('._bs_track_click_promotion') : null;
