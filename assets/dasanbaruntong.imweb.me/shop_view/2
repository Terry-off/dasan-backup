	.tooltipMotionEnter {
		display: inline-flex;
		opacity: 0;
		transform: translate3d(0, 6px, 0);
		animation: tooltip-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.tooltipMotionLoop {
		display: inline-flex;
		transform: translate3d(0, 0, 0);
		animation: tooltip-bounce 1800ms linear 850ms infinite both;
		will-change: transform;
	}

	@keyframes tooltip-enter {
		0% {
			opacity: 0;
			transform: translate3d(0, 6px, 0);
		}

		28.571% {
			opacity: 0.55;
			transform: translate3d(0, 2.8px, 0);
		}

		66.667% {
			opacity: 0.9;
			transform: translate3d(0, 0.6px, 0);
		}

		100% {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@keyframes tooltip-bounce {
		0% {
			transform: translate3d(0, 0, 0) scaleY(1);
			animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		}

		18% {
			transform: translate3d(0, -3px, 0) scaleY(1.015);
			animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
		}

		34% {
			transform: translate3d(0, 0.35px, 0) scaleY(0.985);
			animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		}

		46% {
			transform: translate3d(0, -0.35px, 0) scaleY(1.006);
			animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		}

		58%,
		100% {
			transform: translate3d(0, 0, 0) scaleY(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tooltipMotionEnter,
		.tooltipMotionLoop {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}

